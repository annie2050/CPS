# Environment variables for CPS server
# JWT secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Server port
PORT=5000

# Database config (example values; adjust for your environment)
DB_SERVER=your_db_server
DB_PORT=1433
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# NODE_ENV determines production vs development cookie security
NODE_ENV=development
